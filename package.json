{
  "name": "teampulse",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "TeamPulse \u2014 a mobile app for managers to assign tasks, collect daily reports from colleagues and track incomplete work.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b",
    "test:rules": "firebase emulators:exec --only firestore --project demo-teampulse \"node --test tests/rules.test.mjs\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-teampulse",
    "dev:cloud": "VITE_FIREBASE_EMULATOR=1 vite --host"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "^15.31.0",
    "typescript": "~5.9.0",
    "vite": "^8.3.1"
  }
}
